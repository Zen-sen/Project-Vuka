{
  "system": {
    "version": "4.6",
    "hardening": "defense_in_depth"
  },
  "veto_gate": {
    "enabled": true,
    "mode": "enforced",
    "safety_mode": "ALLOW_SAFE",
    "endpoint": "http://127.0.0.1:8000/v1/predict-ict",
    "threshold": 0.45,
    "buy_threshold": 0.35
  },
  "notifications": {
    "desktop": {
      "enabled": true,
      "timeout": 5
    },
    "telegram": {
      "enabled": true,
      "bot_token": "",
      "chat_id": ""
    }
  },
  "heartbeat": {
    "enabled": true,
    "interval_seconds": 60
  },
  "trading_governor": {
    "enabled": true,
    "blocked_sessions": ["London Open"],
    "allowed_sessions": ["Asian", "London Close"],
    "allowed_directions": ["SELL"],
    "htf_aligned_exception": true,
    "daily_loss_limit": 50.0,
    "weekly_trade_cap": 10,
    "log_rejections": true
  }
}
